# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shim"

# NextAuth Authentication
NEXTAUTH_URL="http://localhost:3100"
NEXTAUTH_SECRET="your-nextauth-secret-key-at-least-32-chars"

# Email Configuration (Nodemailer SMTP)
# If SMTP_HOST is not set, emails are simulated in mock mode (logged to server console).
# To send REAL emails to attendees:
# Example for Gmail:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-16-char-gmail-app-password" # Generated in Google Account > Security > 2-Step Verification > App Passwords
# SMTP_FROM='"Shim Platform" <your-email@gmail.com>'

# Example for Brevo / SendGrid / Mailgun / Custom SMTP:
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT=587
# SMTP_USER="your-smtp-login"
# SMTP_PASS="your-smtp-key"
# SMTP_FROM='"Shim Platform" <noreply@yourdomain.com>'
