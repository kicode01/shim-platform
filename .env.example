# Database (Hosted on Prisma Data Platform at db.prisma.io)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# NextAuth Authentication
NEXTAUTH_URL="http://localhost:3100"
NEXTAUTH_SECRET="your-nextauth-secret-key-at-least-32-chars"

# Email Configuration (Nodemailer SMTP)
# If SMTP_HOST is not set, emails are simulated in mock mode (logged to server console).
# To send REAL emails to attendees:

# Option A: Using your Personal Gmail Account (with "Shim Platform" as the sender name)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=465
# SMTP_USER="your-personal@gmail.com"
# SMTP_PASS="xxxx xxxx xxxx xxxx" # 16-character Google App Password (from Google Account > Security > 2-Step Verification > App passwords)
# SMTP_FROM='"Shim Platform" <your-personal@gmail.com>'
# SMTP_REPLY_TO="your-support@yourdomain.com" # (Optional: where attendee replies will go)

# Option B: Using a Transactional Provider like Brevo / Resend / SendGrid (Sends as noreply@yourdomain.com)
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT=587
# SMTP_USER="your-brevo-login"
# SMTP_PASS="your-brevo-key"
# SMTP_FROM='"Shim Platform" <noreply@shimplatform.com>'
